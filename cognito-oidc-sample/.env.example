# =============================================================================
# 環境変数テンプレート
# =============================================================================
# このファイルを .env にコピーして使用してください:
#   cp .env.example .env
#
# または、Terraform apply 後に `make env` で自動生成できます。
#
# 注意: .env ファイルはシークレット情報を含むため、.gitignore で除外されています。
# =============================================================================

# Cognito Hosted UI のベースURL
# Terraform output: cognito_domain
COGNITO_DOMAIN=https://cognito-oidc-sample.auth.ap-northeast-1.amazoncognito.com

# Cognito App Client ID（パブリッククライアント・シークレットなし）
# Terraform output: client_id
CLIENT_ID=your-client-id-here

# 認可コードのコールバックURL
REDIRECT_URI=http://localhost:8080/callback

# ログアウト後のリダイレクトURL
LOGOUT_REDIRECT_URI=http://localhost:8080

# JWKS エンドポイント（JWT署名検証用の公開鍵取得先）
# Terraform output: jwks_uri
JWKS_URI=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_XXXXXXX/.well-known/jwks.json

# トークン発行者（JWT の iss クレームと照合）
# Terraform output: issuer
ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_XXXXXXX
