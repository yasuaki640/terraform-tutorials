# =============================================================================
# Terraform / Provider 設定
# =============================================================================
# なぜ required_version を指定するか:
#   チーム全員が同じバージョン以上を使うことで、予期しない動作の差異を防ぐ。
#   特に本番環境では、バージョンの不一致が深刻な問題を引き起こす可能性がある。
# =============================================================================

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # なぜ default_tags を使うか:
  #   すべてのリソースに自動でタグを付与できる。
  #   実務ではコスト管理・リソース特定・環境識別のためにタグは必須。
  #   各リソースで個別にタグを書く手間を省き、付け忘れも防止する。
  default_tags {
    tags = {
      Project   = var.project_name
      ManagedBy = "Terraform"
    }
  }
}
