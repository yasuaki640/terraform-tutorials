# このファイルを terraform.tfvars にコピーして使用してください
# cp terraform.tfvars.example terraform.tfvars
#
# 注意: project_name は Cognito Hosted UI のドメインプレフィックスとして使用されます。
# AWS 全体でグローバルに一意である必要があるため、他のアカウントと衝突する場合は
# 値を変更してください（例: "cognito-oidc-sample-yourname"）。

aws_region   = "ap-northeast-1"
project_name = "cognito-oidc-sample"
